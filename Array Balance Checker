#include <stdio.h>

int main() {
    int N;
    scanf("%d", &N);
    
    int arr[1000];
    for(int i = 0; i < N; i++) {
        scanf("%d", &arr[i]);
    }
    
    int mid = N / 2;
    int first_half = 0, second_half = 0;
    
    for(int i = 0; i < mid; i++) {
        first_half += arr[i];
    }
    for(int i = mid; i < N; i++) {
        second_half += arr[i];
    }
    
    if(first_half == second_half) {
        printf("BALANCED\n");
    } else {
        printf("NOT BALANCED\n");
    }
    
    return 0;
}
