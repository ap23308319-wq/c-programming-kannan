#include <stdio.h>

int main() {
    int n1, n2;
    int a[20], b[20];
    int i, j;

    scanf("%d", &n1);
    for(i = 0; i < n1; i++) {
        scanf("%d", &a[i]);
    }

    scanf("%d", &n2);
    for(i = 0; i < n2; i++) {
        scanf("%d", &b[i]);
    }

    i = 0;
    j = 0;

    while(i < n1 && j < n2) {
        if(a[i] < b[j]) {
            printf("%d ", a[i]);
            i++;
        }
        else if(a[i] > b[j]) {
            printf("%d ", b[j]);
            j++;
        }
        else { 
            printf("%d ", a[i]);
            i++;
            j++;
        }
    }

 
    while(i < n1) {
        printf("%d ", a[i]);
        i++;
    }

    while(j < n2) {
        printf("%d ", b[j]);
        j++;
    }

    return 0;
}
